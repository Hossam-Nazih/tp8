<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence
             http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd"
             version="2.2">
    <!-- Ouverte par JpaUtil. Le pilote, l'URL, l'utilisateur, le mot de passe et le dialecte n'apparaissent pas ici :
         JpaUtil les ajoute depuis database.properties, pour que JPA et les migrations visent la même base. -->
    <persistence-unit name="ReservationPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.example.model.Batiment</class>
        <class>com.example.model.Salle</class>
        <class>com.example.model.Equipement</class>
        <class>com.example.model.Utilisateur</class>
        <class>com.example.model.Reservation</class>

        <!-- Seules les entités annotées @Cacheable vont dans le cache de second niveau -->
        <shared-cache-mode>ENABLE_SELECTIVE</shared-cache-mode>

        <properties>
            <!-- Le schéma appartient aux scripts de db/migration (étape 5) : Hibernate ne crée ni ne modifie
                 aucune table, il vérifie seulement au démarrage que les entités correspondent aux colonnes -->
            <property name="hibernate.hbm2ddl.auto" value="validate"/>

            <!-- Étape 2 : voir dans la console si une entité vient de la base (un SELECT s'affiche) ou du cache (rien) -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <!-- Ajoute en tête de chaque requête un commentaire /* ... */ indiquant la requête JPQL d'origine -->
            <property name="hibernate.use_sql_comments" value="true"/>

            <!-- ===== Cache de second niveau ===== -->
            <property name="hibernate.cache.use_second_level_cache" value="true"/>
            <property name="hibernate.cache.region.factory_class" value="org.hibernate.cache.jcache.JCacheRegionFactory"/>
            <property name="hibernate.javax.cache.provider" value="org.ehcache.jsr107.EhcacheCachingProvider"/>
            <!-- Sans cette ligne EhCache ignore ehcache.xml et crée des caches sans limite de taille ni durée de vie -->
            <property name="hibernate.javax.cache.uri" value="ehcache.xml"/>
            <property name="hibernate.cache.use_query_cache" value="true"/>

            <!-- Étape 7 : statistiques lues par PerformanceReport -->
            <property name="hibernate.generate_statistics" value="true"/>
            <!-- ...sans le bilan que Hibernate écrirait à la fermeture de chaque EntityManager -->
            <property name="hibernate.session.events.log" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
